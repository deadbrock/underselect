// =============================================================================
// Prisma Schema — Underselect E-commerce Premium
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  label       String
  description String?
  sortOrder   Int       @default(0)
  status      String    @default("active")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Collection {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  status      String    @default("active")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Selection {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  sku                    String   @unique
  shortDescription       String
  fullDescription        String   @db.Text
  categoryId             String
  category               Category @relation(fields: [categoryId], references: [id])
  type                   String
  collectionId           String?
  collection             Collection? @relation(fields: [collectionId], references: [id])
  team                   String?
  selection              String?
  brand                  String
  season                 String
  tags                   String[]
  price                  Decimal  @db.Decimal(10, 2)
  compareAtPrice         Decimal? @db.Decimal(10, 2)
  cost                   Decimal? @db.Decimal(10, 2)
  weight                 Decimal? @db.Decimal(8, 3)
  height                 Decimal? @db.Decimal(8, 2)
  width                  Decimal? @db.Decimal(8, 2)
  length                 Decimal? @db.Decimal(8, 2)
  isFeatured             Boolean  @default(false)
  isNew                  Boolean  @default(false)
  onSale                 Boolean  @default(false)
  isBestSeller           Boolean  @default(false)
  status                 String   @default("draft")
  inStock                Boolean  @default(true)
  stockQuantity          Int      @default(0)
  minStock               Int      @default(5)
  sizes                  String[]
  installmentCount       Int      @default(6)
  imageUrl               String
  imageAlt               String?
  badge                  String?
  metaTitle              String
  metaDescription        String
  seoSlug                String
  keywords               String?
  ogTitle                String?
  ogDescription          String?
  ogImage                String?
  description            String?  @db.Text
  returnsPolicy          String?  @db.Text
  estimatedDelivery      String?
  customizationAvailable Boolean  @default(false)
  specifications         Json?
  sizeChart              Json?
  faq                    Json?
  unavailableSizes       String[]
  reviewsAverage         Float    @default(0)
  reviewsCount           Int      @default(0)
  reviewsDistribution    Json?
  reviewsComments        Json?
  variations             ProductVariation[]
  gallery                ProductGalleryImage[]
  colors                 ProductColor[]
  models                 ProductModel[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([collectionId])
  @@index([team])
  @@index([selection])
  @@index([isFeatured])
  @@index([isNew])
  @@index([onSale])
}

model ProductVariation {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  color     String?
  model     String?
  sku       String  @unique
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)
  minStock  Int     @default(5)
  imageUrl  String?
}

model ProductGalleryImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isCover   Boolean @default(false)
  sortOrder Int     @default(0)
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  hex       String  @default("#1a1a1a")
  disabled  Boolean @default(false)
}

model ProductModel {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  disabled  Boolean @default(false)
}

model StoreSettings {
  id                   String   @id @default("default")
  storeName            String
  contactEmail         String
  contactPhone         String   @default("")
  storeLocation        String
  instagramUrl         String   @default("")
  maxInstallments      Int      @default(2)
  freeShippingMinValue Decimal  @default(599) @db.Decimal(10, 2)
  estimatedDelivery    String
  promoBarEnabled      Boolean  @default(false)
  promoBarMessage      String
  ordersAlertEmail     String
  maintenanceMode      Boolean  @default(false)
  shippingOriginCep    String   @default("")
  shippingOriginStreet String   @default("")
  shippingOriginNumber String   @default("")
  shippingOriginComplement String @default("")
  shippingOriginNeighborhood String @default("")
  shippingOriginCity   String   @default("")
  shippingOriginState  String   @default("")
  shippingBaseFee      Decimal  @default(0) @db.Decimal(10, 2)
  shippingPerKm        Decimal  @default(0) @db.Decimal(10, 2)
  shippingMinFee       Decimal  @default(0) @db.Decimal(10, 2)
  shippingMaxFee       Decimal  @default(0) @db.Decimal(10, 2)
  freeShippingEnabled  Boolean  @default(false)
  distanceCalculationEnabled Boolean @default(false)
  distanceRangesEnabled Boolean @default(false)
  updatedAt            DateTime @updatedAt
}

model ShippingDistanceRange {
  id            String   @id @default(cuid())
  startKm       Decimal  @db.Decimal(10, 2)
  endKm         Decimal  @db.Decimal(10, 2)
  pricePerKm    Decimal  @db.Decimal(10, 2)
  additionalFee Decimal  @default(0) @db.Decimal(10, 2)
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@index([enabled])
}

model Influencer {
  id             String     @id @default(cuid())
  name           String
  publicName     String
  email          String
  phone          String     @default("")
  instagram      String?
  tiktok         String?
  youtube        String?
  identifierCode String     @unique
  status         String     @default("active")
  notes          String?    @db.Text
  campaigns      Campaign[]
  coupons        Coupon[]
  orders         Order[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
  @@index([identifierCode])
}

model Campaign {
  id           String     @id @default(cuid())
  name         String
  description  String?    @db.Text
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Restrict)
  startDate    DateTime
  endDate      DateTime
  status       String     @default("planned")
  objective    String?
  ordersGoal   Int?
  salesGoal    Decimal?   @db.Decimal(12, 2)
  notes        String?    @db.Text
  categoryIds  String[]   @default([])
  productIds   String[]   @default([])
  coupons      Coupon[]
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([influencerId])
  @@index([status])
  @@index([startDate, endDate])
}

model Coupon {
  id                    String             @id @default(cuid())
  code                  String             @unique
  name                  String
  description           String?            @db.Text
  discountType          String
  discountValue         Decimal            @db.Decimal(10, 2)
  startDate             DateTime
  endDate               DateTime
  usageLimit            Int?
  usageLimitPerCustomer Int?
  status                String             @default("active")
  campaignId            String?
  campaign              Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  influencerId          String?
  influencer            Influencer?        @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  rules                 Json               @default("{}")
  categoryIds           String[]           @default([])
  productIds            String[]           @default([])
  variationIds          String[]           @default([])
  usageCount            Int                @default(0)
  redemptions           CouponRedemption[]
  orders                Order[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([code])
  @@index([status])
  @@index([campaignId])
  @@index([influencerId])
  @@index([startDate, endDate])
}

model Customer {
  id           String             @id @default(cuid())
  firstName    String
  lastName     String
  email        String             @unique
  cpf          String             @unique
  phone        String
  passwordHash String?
  status       String             @default("active")
  lastLoginAt  DateTime?
  orders       Order[]
  redemptions  CouponRedemption[]
  sessions     CustomerSession[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([email])
  @@index([status])
}

model CustomerSession {
  id        String   @id @default(cuid())
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model Order {
  id               String            @id @default(cuid())
  number           String            @unique
  status           String            @default("new")
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subtotal         Decimal           @db.Decimal(10, 2)
  shipping         Decimal           @default(0) @db.Decimal(10, 2)
  discount         Decimal           @default(0) @db.Decimal(10, 2)
  total            Decimal           @db.Decimal(10, 2)
  couponId         String?
  coupon           Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode       String?
  couponDiscount   Decimal?          @db.Decimal(10, 2)
  influencerId     String?
  influencer       Influencer?       @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  campaignId       String?
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  paymentMethod    String
  paymentStatus    String            @default("pending")
  stockDecremented Boolean           @default(false)
  shippingAddress  Json
  shippingMethod   String?
  items            OrderItem[]
  redemption       CouponRedemption?
  paymentTransactions PaymentTransaction[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([couponId])
  @@index([influencerId])
  @@index([campaignId])
  @@index([createdAt])
}

model PaymentTransaction {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String   @default("infinitepay")
  orderNsu        String
  transactionNsu  String?  @unique
  invoiceSlug     String?
  amountCents     Int
  paidAmountCents Int?
  installments    Int?
  captureMethod   String?
  status          String   @default("pending")
  receiptUrl      String?
  checkoutUrl     String?
  rawPayload      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([orderNsu])
  @@index([status])
  @@index([invoiceSlug])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  variationId String?
  slug        String
  sku         String
  name        String
  imageUrl    String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)
  size        String?
  colorLabel  String?
  modelLabel  String?

  @@index([orderId])
  @@index([productId])
}

model CouponRedemption {
  id             String    @id @default(cuid())
  couponId       String
  coupon         Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  influencerId   String?
  campaignId     String?
  discountAmount Decimal   @db.Decimal(10, 2)
  orderTotal     Decimal   @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())

  @@index([couponId])
  @@index([customerId])
  @@index([influencerId])
  @@index([campaignId])
  @@index([createdAt])
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  phone        String?
  role         String         @default("admin")
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
