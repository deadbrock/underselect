# UNDER SELECT — variáveis de ambiente (template — sem valores reais)

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Underselect

# Banco (Supabase PostgreSQL)
# Produção Vercel/Railway: use o POOLER (porta 6543) em DATABASE_URL
# DATABASE_URL=postgresql://postgres.[ref]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[ref]:[SENHA]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=
DIRECT_URL=

# InfinitePay Checkout Integrado (somente servidor — nunca NEXT_PUBLIC_)
INFINITEPAY_HANDLE=sua_infinite_tag
# Produção — URLs públicas do app deployado:
# APP_URL=https://seu-dominio.vercel.app
# INFINITEPAY_REDIRECT_URL=https://seu-dominio.vercel.app/checkout/retorno
# INFINITEPAY_WEBHOOK_URL=https://seu-dominio.vercel.app/api/webhooks/infinitepay
# INFINITEPAY_API_BASE_URL=https://api.checkout.infinitepay.io

# URL base do app (servidor — redirect/webhook InfinitePay)
# APP_URL=https://seu-dominio.com

# Autenticação (somente servidor — NUNCA NEXT_PUBLIC_)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=gere_um_segredo_longo_e_aleatorio_aqui

# Seed local apenas — NÃO definir em produção
ADMIN_SEED_EMAIL=admin@underselect.com
ADMIN_SEED_PASSWORD=Admin@123456
ADMIN_SEED_NAME=Administrador

LOG_LEVEL=debug