# UNDER SELECT — variáveis de ambiente

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Underselect

# Banco (Supabase PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# InfinitePay Checkout Integrado (somente servidor — nunca NEXT_PUBLIC_)
INFINITEPAY_HANDLE=sua_infinite_tag
# Opcional: sobrescrever URLs geradas automaticamente
# INFINITEPAY_REDIRECT_URL=https://seu-dominio.com/checkout/retorno
# INFINITEPAY_WEBHOOK_URL=https://seu-dominio.com/api/webhooks/infinitepay
# INFINITEPAY_API_BASE_URL=https://api.checkout.infinitepay.io

# URL base do app (fallback para redirect/webhook)
# APP_URL=https://seu-dominio.com

# Autenticação admin (somente servidor)
AUTH_SECRET=gere_um_segredo_longo_e_aleatorio_aqui
ADMIN_SEED_EMAIL=admin@underselect.com
ADMIN_SEED_PASSWORD=Admin@123456
ADMIN_SEED_NAME=Administrador

LOG_LEVEL=debug
