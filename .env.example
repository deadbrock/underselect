# =============================================================================
# Underselect — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# =============================================================================

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Underselect

# =============================================================================
# Database — Supabase (PostgreSQL)
# =============================================================================
# No painel Supabase: Project Settings > Database > Connection string
#
# DATABASE_URL (Transaction pooler — porta 6543)
# Use na aplicação (Next.js / Prisma Client). Recomendado para serverless.
# Exemplo:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# DIRECT_URL (Direct connection — porta 5432)
# Use em migrations (`npm run db:migrate`, `npm run db:migrate:deploy`).
# Exemplo:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Se a senha tiver caracteres especiais, use URL encoding (@ = %40, # = %23, etc.).

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/underselect?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/underselect?schema=public"

# Logging
LOG_LEVEL=debug

# Docker (opcional — usado pelo docker-compose local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=underselect
POSTGRES_PORT=5432
